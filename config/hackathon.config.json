{
  "_comment": "Preset for new/low-tier OpenAI accounts (hackathon). Low concurrency, patient rate-limit handling, no escalation to a bigger model. Replace dataPaths with your CSV(s).",
  "dataPaths": ["./examples/sample_comments.csv"],
  "schemaPath": "./examples/schema.jsonld",
  "rulesPath": "./config/sample_comments.rules.json",
  "outputPath": "./output/hackathon.jsonld",
  "enableLogging": true,
  "hidePII": true,
  "batchSize": 5,
  "concurrencySize": 2,
  "retriesNumber": 3,
  "rateLimitMaxRetries": 8,
  "rateLimitMaxWaitMs": 120000,
  "sdkMaxRetries": 0,
  "adaptiveConcurrency": true,
  "failFast": false,
  "defaultModel": "gpt-4.1-mini",
  "fallbackModel": "gpt-4.1-mini",
  "temperature": 0,
  "uuidColumn": "primaryEmail",
  "resumeMode": "auto",
  "forceReingestion": false,
  "requiredFieldErrorsFailBatch": false
}
